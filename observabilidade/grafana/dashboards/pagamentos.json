{
  "uid": "pagamentos-fluxo",
  "title": "Pagamentos — fluxo de eventos",
  "tags": [
    "pagamentos",
    "micrometer"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pagamento_evento_processamento_seconds_count, env)",
          "refId": "env"
        },
        "definition": "label_values(pagamento_evento_processamento_seconds_count, env)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "arranjo",
        "label": "Arranjo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pagamento_evento_processamento_seconds_count{env=~\"$env\"}, arranjo)",
          "refId": "arranjo"
        },
        "definition": "label_values(pagamento_evento_processamento_seconds_count{env=~\"$env\"}, arranjo)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "status_evento",
        "label": "Status do evento",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pagamento_evento_processamento_seconds_count{env=~\"$env\", arranjo=~\"$arranjo\"}, status_evento)",
          "refId": "status_evento"
        },
        "definition": "label_values(pagamento_evento_processamento_seconds_count{env=~\"$env\", arranjo=~\"$arranjo\"}, status_evento)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
